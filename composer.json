{
    "name": "dylan-liew/docs",
    "description": "Private Markdown workspace (Many Notes v0.18.0 fork)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "firebase/php-jwt": "^7.1",
        "inertiajs/inertia-laravel": "^3.3.1",
        "laravel/framework": "^13.29.0",
        "laravel/reverb": "^1.11.1",
        "laravel/scout": "^11.6.1",
        "laravel/tinker": "^3.0.2",
        "laravel/wayfinder": "^0.1.21",
        "staudenmeir/eloquent-has-many-deep": "^1.22.1",
        "staudenmeir/laravel-adjacency-list": "^1.26.1",
        "typesense/typesense-php": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
